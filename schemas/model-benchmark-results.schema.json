{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/model-benchmark-results.schema.json",
  "title": "Model benchmark results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "version",
    "plan_ref",
    "plan_version",
    "plan_sha256",
    "results"
  ],
  "properties": {
    "kind": {"const": "model-benchmark-results"},
    "schema_version": {"const": "1.0"},
    "id": {"$ref": "#/$defs/token"},
    "version": {"type": "string", "pattern": "^v[0-9]{3}$"},
    "plan_ref": {"$ref": "#/$defs/token"},
    "plan_version": {"type": "string", "pattern": "^v[0-9]{3}$"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/result"}
    },
    "notes": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "sampler", "scheduler", "steps", "cfg", "prompt_format"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "sampler": {"$ref": "#/$defs/token"},
        "scheduler": {"$ref": "#/$defs/token"},
        "steps": {"type": "integer", "minimum": 1},
        "cfg": {"type": "number", "exclusiveMinimum": 0},
        "prompt_format": {"type": "string", "minLength": 1}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/token"},
        "message": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "state",
        "model_family",
        "model_profile_ref",
        "model_profile_sha256",
        "workflow_sha256",
        "seed",
        "prompt_case_id",
        "role_scope",
        "settings",
        "elapsed_ms"
      ],
      "properties": {
        "run_id": {"$ref": "#/$defs/token"},
        "state": {"enum": ["succeeded", "failed"]},
        "model_family": {"$ref": "#/$defs/token"},
        "model_profile_ref": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@v[0-9]{3}$"},
        "model_profile_sha256": {"$ref": "#/$defs/sha256"},
        "workflow_sha256": {"$ref": "#/$defs/sha256"},
        "seed": {"type": "integer", "minimum": 0},
        "prompt_case_id": {"$ref": "#/$defs/token"},
        "role_scope": {"enum": ["single-role", "two-character-secondary"]},
        "settings": {"$ref": "#/$defs/settings"},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "peak_vram_mib": {"type": "integer", "minimum": 0},
        "image_path": {"$ref": "#/$defs/relativePath"},
        "image_sha256": {"$ref": "#/$defs/sha256"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "error": {"$ref": "#/$defs/error"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"state": {"const": "succeeded"}},
            "required": ["state"]
          },
          "then": {
            "required": ["image_path", "image_sha256", "width", "height"],
            "not": {"required": ["error"]}
          },
          "else": {
            "required": ["error"],
            "not": {
              "anyOf": [
                {"required": ["image_path"]},
                {"required": ["image_sha256"]},
                {"required": ["width"]},
                {"required": ["height"]}
              ]
            }
          }
        }
      ]
    }
  }
}
