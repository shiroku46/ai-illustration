{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/identity-lock-results.schema.json",
  "title": "Identity lock experiment results",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "id", "version", "plan_ref", "plan_version", "plan_sha256", "results"],
  "properties": {
    "kind": {"const": "identity-lock-results"},
    "schema_version": {"const": "1.0"},
    "id": {"$ref": "#/$defs/token"},
    "version": {"type": "string", "pattern": "^v[0-9]{3}$"},
    "plan_ref": {"$ref": "#/$defs/token"},
    "plan_version": {"type": "string", "pattern": "^v[0-9]{3}$"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}},
    "notes": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "profileRef": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@v[0-9]{3}$"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/token"},
        "message": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "common": {
      "type": "object",
      "required": ["run_id", "state", "model_family", "model_profile_ref", "model_profile_sha256", "workflow_sha256", "role", "candidate_id", "request_id", "identity_sha256", "strategy_id", "strategy_type", "pose", "expression", "control_sha256", "elapsed_ms"]
    },
    "result": {
      "oneOf": [
        {
          "allOf": [
            {"$ref": "#/$defs/common"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["run_id", "state", "model_family", "model_profile_ref", "model_profile_sha256", "workflow_sha256", "role", "candidate_id", "request_id", "identity_sha256", "strategy_id", "strategy_type", "pose", "expression", "control_sha256", "elapsed_ms", "image_path", "image_sha256", "width", "height"],
              "properties": {
                "run_id": {"$ref": "#/$defs/token"},
                "state": {"const": "succeeded"},
                "model_family": {"$ref": "#/$defs/token"},
                "model_profile_ref": {"$ref": "#/$defs/profileRef"},
                "model_profile_sha256": {"$ref": "#/$defs/sha256"},
                "workflow_sha256": {"$ref": "#/$defs/sha256"},
                "role": {"enum": ["boke", "tsukkomi"]},
                "candidate_id": {"$ref": "#/$defs/token"},
                "request_id": {"$ref": "#/$defs/token"},
                "identity_sha256": {"$ref": "#/$defs/sha256"},
                "strategy_id": {"$ref": "#/$defs/token"},
                "strategy_type": {"enum": ["reference-only", "reference-plus-pose", "character-lora"]},
                "pose": {"$ref": "#/$defs/token"},
                "expression": {"$ref": "#/$defs/token"},
                "control_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
                "elapsed_ms": {"type": "integer", "minimum": 0},
                "peak_vram_mib": {"type": "integer", "minimum": 0},
                "image_path": {"$ref": "#/$defs/safePath"},
                "image_sha256": {"$ref": "#/$defs/sha256"},
                "width": {"type": "integer", "minimum": 1, "maximum": 8192},
                "height": {"type": "integer", "minimum": 1, "maximum": 8192}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/common"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["run_id", "state", "model_family", "model_profile_ref", "model_profile_sha256", "workflow_sha256", "role", "candidate_id", "request_id", "identity_sha256", "strategy_id", "strategy_type", "pose", "expression", "control_sha256", "elapsed_ms", "error"],
              "properties": {
                "run_id": {"$ref": "#/$defs/token"},
                "state": {"const": "failed"},
                "model_family": {"$ref": "#/$defs/token"},
                "model_profile_ref": {"$ref": "#/$defs/profileRef"},
                "model_profile_sha256": {"$ref": "#/$defs/sha256"},
                "workflow_sha256": {"$ref": "#/$defs/sha256"},
                "role": {"enum": ["boke", "tsukkomi"]},
                "candidate_id": {"$ref": "#/$defs/token"},
                "request_id": {"$ref": "#/$defs/token"},
                "identity_sha256": {"$ref": "#/$defs/sha256"},
                "strategy_id": {"$ref": "#/$defs/token"},
                "strategy_type": {"enum": ["reference-only", "reference-plus-pose", "character-lora"]},
                "pose": {"$ref": "#/$defs/token"},
                "expression": {"$ref": "#/$defs/token"},
                "control_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
                "elapsed_ms": {"type": "integer", "minimum": 0},
                "peak_vram_mib": {"type": "integer", "minimum": 0},
                "error": {"$ref": "#/$defs/error"}
              }
            }
          ]
        }
      ]
    }
  }
}
