{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/paper-theater-preview.schema.json",
  "title": "Paper Theater Preview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "schema_version",
    "scene_plan_ref",
    "scene_plan_path",
    "scene_plan_sha256",
    "width",
    "height",
    "intent",
    "duration_ms",
    "roles",
    "segments",
    "assets",
    "files"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^paper-theater-preview-[0-9a-f]{20}$"
    },
    "kind": {
      "const": "paper-theater-preview"
    },
    "schema_version": {
      "const": "1.0"
    },
    "scene_plan_ref": {
      "type": "string",
      "pattern": "^paper-theater-scene-plan-[0-9a-f]{20}$"
    },
    "scene_plan_path": {
      "type": "string",
      "minLength": 1
    },
    "scene_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "intent": {
      "enum": [
        "evaluation",
        "production"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boke",
        "tsukkomi"
      ],
      "properties": {
        "boke": {
          "$ref": "#/$defs/role"
        },
        "tsukkomi": {
          "$ref": "#/$defs/role"
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fileAsset"
      }
    },
    "files": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "package_manifest_sha256",
        "variant_set_ref",
        "character_ref",
        "license_status",
        "stage_slot"
      ],
      "properties": {
        "package_id": {
          "type": "string"
        },
        "package_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "variant_set_ref": {
          "type": "string"
        },
        "character_ref": {
          "type": "string"
        },
        "license_status": {
          "type": "string"
        },
        "stage_slot": {
          "enum": [
            "left",
            "right",
            "center"
          ]
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "variant_id",
        "asset_path",
        "png_sha256"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "variant_id": {
          "type": "string"
        },
        "asset_path": {
          "type": "string",
          "pattern": "^assets/[0-9a-f]{64}\\.png$"
        },
        "png_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_ms",
        "end_ms",
        "stage_slots",
        "boke",
        "tsukkomi"
      ],
      "properties": {
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "stage_slots": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boke",
            "tsukkomi"
          ],
          "properties": {
            "boke": {
              "enum": [
                "left",
                "right",
                "center"
              ]
            },
            "tsukkomi": {
              "enum": [
                "left",
                "right",
                "center"
              ]
            }
          }
        },
        "boke": {
          "$ref": "#/$defs/state"
        },
        "tsukkomi": {
          "$ref": "#/$defs/state"
        }
      }
    },
    "fileAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size",
        "source_path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^assets/[0-9a-f]{64}\\.png$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
