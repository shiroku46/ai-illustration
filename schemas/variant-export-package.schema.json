{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "variant-export-package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "kind", "schema_version", "variant_set_ref", "intent",
    "source_candidate_ref", "source_candidate_sha256", "source_request_ref",
    "review_ref", "character_ref", "style_ref", "license_status",
    "paper_theater_index_path", "paper_theater_index_sha256", "items"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^variant-export-package-[0-9a-f]{20}$"},
    "kind": {"const": "variant-export-package"},
    "schema_version": {"const": "1.0"},
    "variant_set_ref": {"type": "string", "pattern": "^variant-set-[0-9a-f]{20}$"},
    "intent": {"enum": ["evaluation", "production"]},
    "source_candidate_ref": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "source_candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_request_ref": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "review_ref": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "character_ref": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@v[0-9]{3}$"},
    "style_ref": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@v[0-9]{3}$"},
    "license_status": {"enum": ["unreviewed", "reviewing", "approved", "rejected"]},
    "paper_theater_index_path": {"const": "paper-theater-index.json"},
    "paper_theater_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id", "paper_theater_key", "png_path", "png_sha256",
          "sidecar_path", "sidecar_sha256"
        ],
        "properties": {
          "variant_id": {"type": "string", "pattern": "^variant-[0-9a-f]{20}$"},
          "paper_theater_key": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
          "png_path": {"type": "string", "pattern": "^variants/v1/.+\\.png$"},
          "png_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sidecar_path": {"type": "string", "pattern": "^variants/v1/.+\\.json$"},
          "sidecar_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "variant_review_ref": {"type": "string", "pattern": "^variant-review-[0-9a-f]{20}$"},
          "variant_review_path": {"type": "string", "pattern": "^reviews/variant-[0-9a-f]{20}\\.json$"},
          "variant_review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"intent": {"const": "production"}}},
      "then": {
        "properties": {
          "items": {
            "items": {
              "required": ["variant_review_ref", "variant_review_path", "variant_review_sha256"]
            }
          }
        }
      },
      "else": {
        "properties": {
          "items": {
            "items": {
              "allOf": [
                {"not": {"required": ["variant_review_ref"]}},
                {"not": {"required": ["variant_review_path"]}},
                {"not": {"required": ["variant_review_sha256"]}}
              ]
            }
          }
        }
      }
    }
  ]
}
