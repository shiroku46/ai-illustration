{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-theater-render-plan.schema.json",
  "title": "Paper theater renderer-neutral render plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "schema_version",
    "source_bindings",
    "intent",
    "audio_license_status",
    "width",
    "height",
    "scene_duration_ms",
    "fps_num",
    "fps_den",
    "frame_time_unit",
    "frame_boundary_policy",
    "frame_count",
    "frames",
    "spans",
    "audio_placement",
    "output_target",
    "files"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^paper-theater-render-plan-[0-9a-f]{20}$"},
    "kind": {"const": "paper-theater-render-plan"},
    "schema_version": {"const": "1.0"},
    "source_bindings": {"type": "object"},
    "intent": {"enum": ["evaluation", "production"]},
    "audio_license_status": {"enum": ["unreviewed", "reviewing", "approved", "rejected"]},
    "width": {"type": "integer", "minimum": 1, "maximum": 8192},
    "height": {"type": "integer", "minimum": 1, "maximum": 8192},
    "scene_duration_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
    "fps_num": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "fps_den": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "frame_time_unit": {"const": "milliseconds"},
    "frame_boundary_policy": {"const": "state-at-frame-start"},
    "frame_count": {"type": "integer", "minimum": 1, "maximum": 2000000},
    "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frame"}},
    "spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}},
    "audio_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "offset_ms", "start_sample_num", "start_sample_den", "source_sample_rate", "source_frame_count", "duration_policy", "synchronized_audio_end_ms"],
      "properties": {
        "policy": {"const": "signed-rational-sample-offset-no-resampling"},
        "offset_ms": {"type": "integer", "minimum": -86400000, "maximum": 86400000},
        "start_sample_num": {"type": "integer"},
        "start_sample_den": {"const": 1000},
        "source_sample_rate": {"type": "integer", "minimum": 8000, "maximum": 192000},
        "source_frame_count": {"type": "integer", "minimum": 1},
        "duration_policy": {"enum": ["exact", "audio-at-least-scene", "scene-at-least-audio"]},
        "synchronized_audio_end_ms": {"type": "integer"}
      }
    },
    "output_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "video_container", "video_codec", "audio_codec", "pixel_width", "pixel_height", "frame_count", "media_created"],
      "properties": {
        "kind": {"const": "renderer-neutral-media-target"},
        "video_container": {"const": "unspecified"},
        "video_codec": {"const": "unspecified"},
        "audio_codec": {"const": "copy-or-renderer-defined"},
        "pixel_width": {"type": "integer", "minimum": 1, "maximum": 8192},
        "pixel_height": {"type": "integer", "minimum": 1, "maximum": 8192},
        "frame_count": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "media_created": {"const": false}
      }
    },
    "files": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/file"}}
  },
  "allOf": [
    {
      "if": {"properties": {"intent": {"const": "production"}}},
      "then": {"properties": {"audio_license_status": {"const": "approved"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "variant_id", "asset_path", "png_sha256", "stage_slot"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "variant_id": {"type": "string", "minLength": 1},
        "asset_path": {"$ref": "#/$defs/path"},
        "png_sha256": {"$ref": "#/$defs/sha256"},
        "stage_slot": {"type": "string", "minLength": 1}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "start_time_num", "end_time_num", "time_den", "boke", "tsukkomi"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "start_time_num": {"type": "integer", "minimum": 0},
        "end_time_num": {"type": "integer", "minimum": 1},
        "time_den": {"type": "integer", "minimum": 1},
        "boke": {"$ref": "#/$defs/state"},
        "tsukkomi": {"$ref": "#/$defs/state"}
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_frame", "end_frame", "start_time_num", "end_time_num", "time_den", "boke", "tsukkomi"],
      "properties": {
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame": {"type": "integer", "minimum": 1},
        "start_time_num": {"type": "integer", "minimum": 0},
        "end_time_num": {"type": "integer", "minimum": 1},
        "time_den": {"type": "integer", "minimum": 1},
        "boke": {"$ref": "#/$defs/state"},
        "tsukkomi": {"$ref": "#/$defs/state"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1}
      }
    }
  }
}
