{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/tool-profile.schema.json",
  "title": "Tool Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter_type", "commercial_use_review_state", "control_capabilities", "decision_state", "deterministic_seed_support", "evidence_references", "id", "install_state", "kind", "license_evidence_state", "minimum_ram_gb", "minimum_vram_gb", "offline_capability", "profile_type", "runtime_type", "schema_version", "supported_operating_systems", "version"],
  "properties": {
    "kind": {"const": "tool-profile"},
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^v[0-9]{3}$"},
    "profile_type": {"enum": ["tool", "model-configuration"]},
    "adapter_type": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "runtime_type": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "offline_capability": {"enum": ["yes", "no", "unknown"]},
    "deterministic_seed_support": {"type": "boolean"},
    "control_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "minimum_vram_gb": {"type": "number", "minimum": 0},
    "minimum_ram_gb": {"type": "number", "minimum": 0},
    "supported_operating_systems": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["windows", "linux", "macos"]}},
    "install_state": {"enum": ["unknown", "uninstalled", "installed"]},
    "evidence_references": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_url", "retrieved_at", "claim"], "properties": {"source_url": {"type": "string", "pattern": "^https://"}, "retrieved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "claim": {"type": "string", "minLength": 1}}}},
    "license_evidence_state": {"enum": ["unreviewed", "reviewing", "approved", "rejected"]},
    "commercial_use_review_state": {"enum": ["unreviewed", "reviewing", "approved", "rejected"]},
    "decision_state": {"enum": ["unreviewed", "reviewing", "approved", "rejected"]}
  }
}
