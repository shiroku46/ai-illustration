{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/paper-theater-composition-profile.schema.json",
  "title": "Paper Theater Composition Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "schema_version",
    "canvas",
    "slots"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^paper-theater-composition-profile-[0-9a-f]{20}$"
    },
    "kind": {
      "const": "paper-theater-composition-profile"
    },
    "schema_version": {
      "const": "1.0"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "background_rgba"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "background_rgba": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/slot"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "name": {
                "const": "left"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "right"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source_anchor",
        "target_anchor",
        "scale",
        "translation",
        "z_order"
      ],
      "properties": {
        "name": {
          "enum": [
            "left",
            "right"
          ]
        },
        "source_anchor": {
          "$ref": "#/$defs/point"
        },
        "target_anchor": {
          "$ref": "#/$defs/point"
        },
        "scale": {
          "$ref": "#/$defs/scale"
        },
        "translation": {
          "$ref": "#/$defs/point"
        },
        "z_order": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      }
    }
  }
}
