{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/paper-theater-scene-plan.schema.json",
  "title": "Paper Theater Scene Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "schema_version",
    "intent",
    "duration_ms",
    "roles",
    "events",
    "segments"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^paper-theater-scene-plan-[0-9a-f]{20}$"
    },
    "kind": {
      "const": "paper-theater-scene-plan"
    },
    "schema_version": {
      "const": "1.0"
    },
    "intent": {
      "enum": [
        "evaluation",
        "production"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boke",
        "tsukkomi"
      ],
      "properties": {
        "boke": {
          "$ref": "#/$defs/role"
        },
        "tsukkomi": {
          "$ref": "#/$defs/role"
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/segment"
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\\\\\)[^\\u0000]+$"
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_manifest_path",
        "package_id",
        "package_manifest_sha256",
        "variant_set_ref",
        "character_ref",
        "license_status",
        "stage_slot",
        "initial_key"
      ],
      "properties": {
        "package_manifest_path": {
          "$ref": "#/$defs/path"
        },
        "package_id": {
          "type": "string",
          "pattern": "^variant-export-package-[0-9a-f]{20}$"
        },
        "package_manifest_sha256": {
          "$ref": "#/$defs/sha"
        },
        "variant_set_ref": {
          "type": "string",
          "pattern": "^variant-set-[0-9a-f]{20}$"
        },
        "character_ref": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@v[0-9]{3}$"
        },
        "license_status": {
          "enum": [
            "unreviewed",
            "reviewing",
            "approved",
            "rejected"
          ]
        },
        "stage_slot": {
          "enum": [
            "left",
            "right",
            "center"
          ]
        },
        "initial_key": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at_ms",
        "role",
        "key"
      ],
      "properties": {
        "at_ms": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "boke",
            "tsukkomi"
          ]
        },
        "key": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "variant_id",
        "png_path",
        "png_sha256"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "variant_id": {
          "type": "string",
          "pattern": "^variant-[0-9a-f]{20}$"
        },
        "png_path": {
          "$ref": "#/$defs/path"
        },
        "png_sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boke",
        "tsukkomi"
      ],
      "properties": {
        "boke": {
          "enum": [
            "left",
            "right",
            "center"
          ]
        },
        "tsukkomi": {
          "enum": [
            "left",
            "right",
            "center"
          ]
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_ms",
        "end_ms",
        "stage_slots",
        "boke",
        "tsukkomi"
      ],
      "properties": {
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "stage_slots": {
          "$ref": "#/$defs/slots"
        },
        "boke": {
          "$ref": "#/$defs/state"
        },
        "tsukkomi": {
          "$ref": "#/$defs/state"
        }
      }
    }
  }
}
