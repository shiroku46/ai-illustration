{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/model-benchmark-review.schema.json",
  "title": "Owner benchmark review and selected-model lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "plan_ref",
    "plan_version",
    "plan_sha256",
    "results_ref",
    "results_version",
    "results_sha256",
    "package_ref",
    "package_sha256",
    "reviewer",
    "timestamp",
    "decision",
    "accepted_run_ids",
    "rejected_run_ids",
    "hard_fail_categories",
    "observations"
  ],
  "properties": {
    "kind": {"const": "model-benchmark-review"},
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^benchmark-review-[0-9a-f]{16}$"},
    "plan_ref": {"$ref": "#/$defs/token"},
    "plan_version": {"$ref": "#/$defs/version"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "results_ref": {"$ref": "#/$defs/token"},
    "results_version": {"$ref": "#/$defs/version"},
    "results_sha256": {"$ref": "#/$defs/sha256"},
    "package_ref": {"$ref": "#/$defs/token"},
    "package_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer": {"type": "string", "minLength": 1},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "decision": {"enum": ["select_model", "reject_all", "needs_revision"]},
    "selected_model": {"$ref": "#/$defs/selectedModel"},
    "accepted_run_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/token"}
    },
    "rejected_run_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/token"}
    },
    "hard_fail_categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "malformed_or_missing_limb",
          "broken_joint_or_torso",
          "incoherent_clothing",
          "face_asymmetry",
          "unintended_background",
          "generic_ai_style",
          "identity_drift",
          "isolation_failure"
        ]
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"decision": {"const": "select_model"}},
        "required": ["decision"]
      },
      "then": {
        "required": ["selected_model"],
        "properties": {
          "accepted_run_ids": {"minItems": 4}
        }
      },
      "else": {
        "not": {"required": ["selected_model"]},
        "properties": {
          "accepted_run_ids": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "token": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^v[0-9]{3}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selectedModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "profile_ref", "profile_sha256", "workflow_sha256"],
      "properties": {
        "family": {"$ref": "#/$defs/token"},
        "profile_ref": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@v[0-9]{3}$"
        },
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "workflow_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
