{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/identity-lock-review.schema.json",
  "title": "Identity lock owner review",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "id", "plan_ref", "plan_version", "plan_sha256", "results_ref", "results_version", "results_sha256", "package_ref", "package_sha256", "reviewer", "timestamp", "decision", "role_selections", "rejected_evidence", "observations"],
  "properties": {
    "kind": {"const": "identity-lock-review"},
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^identity-review-[0-9a-f]{16}$"},
    "plan_ref": {"$ref": "#/$defs/token"},
    "plan_version": {"type": "string", "pattern": "^v[0-9]{3}$"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "results_ref": {"$ref": "#/$defs/token"},
    "results_version": {"type": "string", "pattern": "^v[0-9]{3}$"},
    "results_sha256": {"$ref": "#/$defs/sha256"},
    "package_ref": {"$ref": "#/$defs/token"},
    "package_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "decision": {"enum": ["approve_identity_lock", "reject", "needs_revision"]},
    "role_selections": {"type": "array", "items": {"$ref": "#/$defs/roleSelection"}},
    "rejected_evidence": {"type": "array", "items": {"$ref": "#/$defs/rejectedEvidence"}},
    "observations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "approve_identity_lock"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "role_selections": {
            "minItems": 2,
            "maxItems": 2,
            "allOf": [
              {"contains": {"properties": {"role": {"const": "boke"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
              {"contains": {"properties": {"role": {"const": "tsukkomi"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1}
            ]
          }
        }
      },
      "else": {"properties": {"role_selections": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "token": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profileRef": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@v[0-9]{3}$"},
    "roleSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "strategy_id", "candidate_id", "request_id", "identity_sha256", "model_family", "model_profile_ref", "model_profile_sha256", "workflow_sha256", "accepted_run_ids"],
      "properties": {
        "role": {"enum": ["boke", "tsukkomi"]},
        "strategy_id": {"$ref": "#/$defs/token"},
        "candidate_id": {"$ref": "#/$defs/token"},
        "request_id": {"$ref": "#/$defs/token"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "model_family": {"$ref": "#/$defs/token"},
        "model_profile_ref": {"$ref": "#/$defs/profileRef"},
        "model_profile_sha256": {"$ref": "#/$defs/sha256"},
        "workflow_sha256": {"$ref": "#/$defs/sha256"},
        "accepted_run_ids": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}}
      }
    },
    "rejectedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "hard_fail_categories"],
      "properties": {
        "run_id": {"$ref": "#/$defs/token"},
        "hard_fail_categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["malformed_or_missing_limb", "broken_joint_or_torso", "incoherent_clothing", "face_asymmetry", "unintended_background", "generic_ai_style", "identity_drift", "isolation_failure"]
          }
        }
      }
    }
  }
}
